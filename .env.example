# Environment variable reference for JIRA-PLAYWRIGHT-AGENT.
#
# Copy to `.env` and fill in real values:   cp .env.example .env
# `.env` is gitignored and must never be committed. Every value below is a
# placeholder. Integrations are optional: when a variable is absent the
# corresponding adapter reports UNAVAILABLE and the core engine still runs
# against a supplied URL or a local fixture.

# ---------------------------------------------------------------- Jira (optional)
# Only src/jira.ts treats these three as required; it throws if they are missing.
# Everything else degrades gracefully when Jira is unconfigured.
JIRA_BASE_URL=https://your-site.atlassian.net   # optional - Jira REST base URL, no trailing slash
JIRA_EMAIL=your-email@example.com                # optional - account used for basic auth
JIRA_API_TOKEN=your-api-token                    # optional - Jira API token, treated as a secret
JIRA_PROJECT_KEY=JPA                            # optional - project scope key; run-approved defaults to LOCAL

# ---------------------------------------------------------------- GitHub (optional)
GITHUB_TOKEN=ghp_your-token-here                # optional - token for private repos; absent = public-only
GITHUB_REPOSITORY=owner/repo                    # optional - shorthand, overridden by OWNER + REPO
GITHUB_OWNER=your-org                           # optional - repository owner
GITHUB_REPO=your-repo                           # optional - repository name
GITHUB_API_BASE_URL=https://api.github.com      # optional - override for GitHub Enterprise
GITHUB_REF=main                                 # optional - default branch to ingest
GITHUB_BRANCH=main                              # optional - legacy alias for GITHUB_REF

# ---------------------------------------------------------------- Notion (optional)
# Any one of the three token names satisfies the integration.
NOTION_INTEGRATION_TOKEN=secret_your-token       # optional - preferred token name
NOTION_API_TOKEN=secret_your-token               # optional - accepted alias
NOTION_API_KEY=secret_your-token                 # optional - accepted alias
NOTION_API_BASE_URL=https://api.notion.com       # optional - API root
NOTION_VERSION=2022-06-28                        # optional - Notion-Version header value

# ---------------------------------------------------------------- Slack (optional)
# Any one of the three token names satisfies the integration.
SLACK_BOT_TOKEN=xoxb-<your-bot-token>           # optional - preferred bot token name
SLACK_TOKEN=xoxp-<your-token>                   # optional - accepted alias
SLACK_API_TOKEN=xoxp-<your-token>               # optional - accepted alias
SLACK_API_BASE_URL=https://slack.com/api         # optional - API root

# ------------------------------------------------------- Agent runtime (optional)
QA_HEALING_FILE=test-results/healing.jsonl       # optional - append healing decisions here when set
SELF_HEALING_MIN_CONFIDENCE=0.85                 # optional - minimum confidence to accept a healed locator
DEMO_SITE_PORT=4173                              # optional - port for the local fixture site
