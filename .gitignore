node_modules/
.env
playwright-report/
test-results/
.playwright-mcp/

# Run artifacts and generated outputs
reports/
test-cases/
pages/
exploration.json
generated-test-cases.json
dummyjson-*.html

# Machine-generated module folders written by the automation generator
# on every run (run-approved -> generateAutomation). Hand-written reference
# specs such as JPA-*.spec.ts stay tracked via the negation below.
tests/generated/*/
!tests/generated/JPA-*.spec.ts

# Throwaway fixture specs written at test time by
# tests/integration/json-reporter-attribution.spec.ts. The test deletes them in
# afterAll; if the process crashes one can survive, so they are never committed.
# A surviving copy is still safe to collect: every test in it is guarded by
# QA_RUN_GENERATED_FIXTURES and skips itself during normal runs.
tests/integration/fixtures/json-attribution-generated-*.spec.ts
tests/integration/fixtures/generated-artifact-*.spec.ts

# Scratch scripts
list-status.js
list-todo.js
read-ticket.js

# Local editor settings; contains extension credential fields (CodeGPT.apiKey)
.vscode/